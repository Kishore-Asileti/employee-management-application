<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0i3htat" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Employee_Management">
    <bpmn:participant id="Employee" name="Employee" processRef="EmployeeManager" />
    <bpmn:group id="Task_HR_Actions" categoryValueRef="CategoryValue_04uyvmv" />
    <bpmn:group id="Group_00uleb9" />
  </bpmn:collaboration>
  <bpmn:process id="EmployeeManager" name="Employee management system" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_0l0mekc">
      <bpmn:lane id="Lane_0wtlei8">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_loginpage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NewOrExisting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ValidationResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendWelcomeEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_HRDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActivateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_04xoktc">
        <bpmn:flowNodeRef>Task_EnterCredentials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuthenticateUser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuthError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AuthResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RoleCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRDashboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManagerDashboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeDashboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ViewEmployeeList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_EmployeeSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_HRAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HR_AddEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HR_EditEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HR_DeleteEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HR_ViewAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HR_SaveChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HRSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ManagerAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mgr_EditEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mgr_ViewAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mgr_DeleteEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mgr_GenerateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mgr_SaveChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ManagerSession</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Employee visits portal">
      <bpmn:outgoing>Flow_1bsgvla</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_loginpage" name="Login/Register">
      <bpmn:incoming>Flow_1bsgvla</bpmn:incoming>
      <bpmn:outgoing>Flow_1lvp2rw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_NewOrExisting" name="New or Existing Employee" default="Flow_gw1_to_authenticate">
      <bpmn:incoming>Flow_1lvp2rw</bpmn:incoming>
      <bpmn:outgoing>Flow_1s5c6lw</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw1_to_authenticate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Register" name="Fill Registration Form">
      <bpmn:incoming>Flow_1s5c6lw</bpmn:incoming>
      <bpmn:incoming>Flow_1x2veep</bpmn:incoming>
      <bpmn:outgoing>Flow_0t8zx7k</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateRegistration" name="Validate &#38; Save&#10;Employee to DB" camunda:delegateExpression="${validateRegistrationDelegate}">
      <bpmn:incoming>Flow_0t8zx7k</bpmn:incoming>
      <bpmn:outgoing>Flow_1c5als8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_ValidationResult" name="Registration Valid?" default="Flow_invalid_to_error">
      <bpmn:incoming>Flow_1c5als8</bpmn:incoming>
      <bpmn:outgoing>Flow_invalid_to_error</bpmn:outgoing>
      <bpmn:outgoing>Flow_valid_to_notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixErrors" name="Show Validation Errors&#10;to Employee" camunda:assignee="${userId}">
      <bpmn:incoming>Flow_invalid_to_error</bpmn:incoming>
      <bpmn:outgoing>Flow_1x2veep</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendWelcomeEmail" name="Send Welcome&#10;Email to Employee" camunda:class="com.company.EmailService">
      <bpmn:incoming>Flow_valid_to_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_17wb5x0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_HRApproval" name="HR Reviews &#38;&#10;Approves New Employee" camunda:candidateGroups="hr">
      <bpmn:incoming>Flow_17wb5x0</bpmn:incoming>
      <bpmn:outgoing>Flow_0kdx1gy</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_HRDecision" name="HR Approved?" default="Flow_hr_rejected">
      <bpmn:incoming>Flow_0kdx1gy</bpmn:incoming>
      <bpmn:outgoing>Flow_hr_rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_hr_approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EnterCredentials" name="Enter Email &#38; Password">
      <bpmn:incoming>Flow_gw1_to_authenticate</bpmn:incoming>
      <bpmn:incoming>Flow_activate_to_login_redirect</bpmn:incoming>
      <bpmn:incoming>Flow_1tua85b</bpmn:incoming>
      <bpmn:outgoing>Flow_credentials_to_auth</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1bsgvla" sourceRef="StartEvent_1" targetRef="Task_loginpage" />
    <bpmn:sequenceFlow id="Flow_1lvp2rw" sourceRef="Task_loginpage" targetRef="Gateway_NewOrExisting" />
    <bpmn:sequenceFlow id="Flow_1s5c6lw" name="New Employee" sourceRef="Gateway_NewOrExisting" targetRef="Task_Register">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isNewEmployee == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw1_to_authenticate" name="Existing Employee" sourceRef="Gateway_NewOrExisting" targetRef="Task_EnterCredentials" />
    <bpmn:sequenceFlow id="Flow_1x2veep" sourceRef="Task_FixErrors" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_0t8zx7k" sourceRef="Task_Register" targetRef="Task_ValidateRegistration" />
    <bpmn:sequenceFlow id="Flow_1c5als8" sourceRef="Task_ValidateRegistration" targetRef="GW_ValidationResult" />
    <bpmn:sequenceFlow id="Flow_invalid_to_error" name="Invalid" sourceRef="GW_ValidationResult" targetRef="Task_FixErrors" />
    <bpmn:sequenceFlow id="Flow_valid_to_notify" name="Valid" sourceRef="GW_ValidationResult" targetRef="Task_SendWelcomeEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${validationResult == 'VALID'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17wb5x0" sourceRef="Task_SendWelcomeEmail" targetRef="Task_HRApproval" />
    <bpmn:sequenceFlow id="Flow_0kdx1gy" sourceRef="Task_HRApproval" targetRef="GW_HRDecision" />
    <bpmn:sequenceFlow id="Flow_hr_rejected" name="Rejected" sourceRef="GW_HRDecision" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_hr_approved" name="Approved" sourceRef="GW_HRDecision" targetRef="Task_ActivateAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hrApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_AuthenticateUser" name="Authenticate User&#10;Check Credentials &#38; Role" camunda:class="com.company.AuthService">
      <bpmn:incoming>Flow_credentials_to_auth</bpmn:incoming>
      <bpmn:outgoing>Flow_auth_to_gw4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_credentials_to_auth" sourceRef="Task_EnterCredentials" targetRef="Task_AuthenticateUser" />
    <bpmn:sequenceFlow id="Flow_activate_to_login_redirect" sourceRef="Task_ActivateAccount" targetRef="Task_EnterCredentials" />
    <bpmn:serviceTask id="Task_ActivateAccount" name="Activate Employee&#10;Account in System" camunda:class="com.company.AccountService">
      <bpmn:incoming>Flow_hr_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_activate_to_login_redirect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_auth_to_gw4" sourceRef="Task_AuthenticateUser" targetRef="GW_AuthResult" />
    <bpmn:sequenceFlow id="Flow_1tua85b" sourceRef="Task_AuthError" targetRef="Task_EnterCredentials" />
    <bpmn:userTask id="Task_AuthError" name="Show Invalid Login&#10;Error Message" camunda:assignee="${userId}">
      <bpmn:incoming>Flow_auth_fail</bpmn:incoming>
      <bpmn:outgoing>Flow_1tua85b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_AuthResult" name="Authentication&#10;Successful?" default="Flow_auth_fail">
      <bpmn:incoming>Flow_auth_to_gw4</bpmn:incoming>
      <bpmn:outgoing>Flow_auth_fail</bpmn:outgoing>
      <bpmn:outgoing>Flow_auth_success</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_auth_fail" name="Failed" sourceRef="GW_AuthResult" targetRef="Task_AuthError" />
    <bpmn:exclusiveGateway id="GW_RoleCheck" name="Check User Role" default="Flow_role_employee">
      <bpmn:incoming>Flow_auth_success</bpmn:incoming>
      <bpmn:outgoing>Flow_role_hr</bpmn:outgoing>
      <bpmn:outgoing>Flow_role_employee</bpmn:outgoing>
      <bpmn:outgoing>Flow_role_manager</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_auth_success" name="Success" sourceRef="GW_AuthResult" targetRef="GW_RoleCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${authResult == 'SUCCESS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_HRDashboard" name="HR Dashboard&#10;(View + Edit + Delete)" camunda:candidateGroups="hr">
      <bpmn:incoming>Flow_role_hr</bpmn:incoming>
      <bpmn:outgoing>Flow_hr_action_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ManagerDashboard" name="Manager Dashboard&#10;(View + Edit + Delete + Reports)" camunda:candidateGroups="manager">
      <bpmn:incoming>Flow_role_manager</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_action_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EmployeeDashboard" name="Employee Dashboard&#10;(View Only)" camunda:assignee="${userId}">
      <bpmn:incoming>Flow_role_employee</bpmn:incoming>
      <bpmn:outgoing>Flow_emp_view</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_role_hr" name="Role = HR" sourceRef="GW_RoleCheck" targetRef="Task_HRDashboard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${userRole == 'HR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_role_employee" name="Role = Employee" sourceRef="GW_RoleCheck" targetRef="Task_EmployeeDashboard" />
    <bpmn:sequenceFlow id="Flow_role_manager" name="Role = Manager" sourceRef="GW_RoleCheck" targetRef="Task_ManagerDashboard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${userRole == 'MANAGER'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_ViewEmployeeList" name="Fetch &#38; Display&#10;All Employees (Read Only)" camunda:class="com.company.EmployeeReadService">
      <bpmn:incoming>Flow_emp_view</bpmn:incoming>
      <bpmn:outgoing>Flow_view_done_emp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Registration Rejected&#10;(Notify Employee)">
      <bpmn:incoming>Flow_hr_rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_EmployeeSession" name="Employee Session End&#10;(Logout)">
      <bpmn:incoming>Flow_view_done_emp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_emp_view" sourceRef="Task_EmployeeDashboard" targetRef="Task_ViewEmployeeList" />
    <bpmn:sequenceFlow id="Flow_view_done_emp" sourceRef="Task_ViewEmployeeList" targetRef="End_EmployeeSession" />
    <bpmn:exclusiveGateway id="GW_HRAction" name="HR Action?" default="Flow_hr_view">
      <bpmn:incoming>Flow_hr_action_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_hr_add</bpmn:outgoing>
      <bpmn:outgoing>Flow_hr_view</bpmn:outgoing>
      <bpmn:outgoing>Flow_hr_edit</bpmn:outgoing>
      <bpmn:outgoing>Flow_hr_delete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_HR_AddEmployee" name="Add New Employee&#10;Record (All Categories)" camunda:candidateGroups="hr">
      <bpmn:incoming>Flow_hr_add</bpmn:incoming>
      <bpmn:outgoing>Flow_hr_add_save</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_hr_action_gw" sourceRef="Task_HRDashboard" targetRef="GW_HRAction" />
    <bpmn:sequenceFlow id="Flow_hr_add" name="Add" sourceRef="GW_HRAction" targetRef="Task_HR_AddEmployee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hrAction == 'ADD'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_HR_EditEmployee" name="Edit Employee Details&#10;(Category, Dept, Role, Status)" camunda:candidateGroups="hr">
      <bpmn:incoming>Flow_hr_edit</bpmn:incoming>
      <bpmn:outgoing>Flow_hr_edit_save</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HR_DeleteEmployee" name="Delete / Deactivate&#10;Employee Record" camunda:candidateGroups="hr">
      <bpmn:incoming>Flow_hr_delete</bpmn:incoming>
      <bpmn:outgoing>Flow_hr_delete_confirm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_HR_ViewAll" name="View All Employee&#10;Categories &#38; Records" camunda:class="com.company.EmployeeReadService">
      <bpmn:incoming>Flow_hr_view</bpmn:incoming>
      <bpmn:outgoing>Flow_hr_view_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_hr_view" name="View" sourceRef="GW_HRAction" targetRef="Task_HR_ViewAll" />
    <bpmn:sequenceFlow id="Flow_hr_edit" name="Edit" sourceRef="GW_HRAction" targetRef="Task_HR_EditEmployee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hrAction == 'EDIT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_hr_delete" name="Delete" sourceRef="GW_HRAction" targetRef="Task_HR_DeleteEmployee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hrAction == 'DELETE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_HR_SaveChanges" name="Save HR Changes to DB&#10;+ Log Audit Trail" camunda:class="com.company.EmployeeWriteService">
      <bpmn:incoming>Flow_hr_add_save</bpmn:incoming>
      <bpmn:incoming>Flow_hr_edit_save</bpmn:incoming>
      <bpmn:incoming>Flow_hr_delete_confirm</bpmn:incoming>
      <bpmn:incoming>Flow_hr_view_done</bpmn:incoming>
      <bpmn:outgoing>Flow_hr_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_hr_add_save" sourceRef="Task_HR_AddEmployee" targetRef="Task_HR_SaveChanges" />
    <bpmn:sequenceFlow id="Flow_hr_edit_save" sourceRef="Task_HR_EditEmployee" targetRef="Task_HR_SaveChanges" />
    <bpmn:sequenceFlow id="Flow_hr_delete_confirm" sourceRef="Task_HR_DeleteEmployee" targetRef="Task_HR_SaveChanges" />
    <bpmn:sequenceFlow id="Flow_hr_view_done" sourceRef="Task_HR_ViewAll" targetRef="Task_HR_SaveChanges" />
    <bpmn:endEvent id="End_HRSession" name="HR Session End&#10;(Logout)">
      <bpmn:incoming>Flow_hr_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_hr_done" sourceRef="Task_HR_SaveChanges" targetRef="End_HRSession" />
    <bpmn:exclusiveGateway id="GW_ManagerAction" name="Manager Action?" default="Flow_mgr_view">
      <bpmn:incoming>Flow_mgr_action_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_edit</bpmn:outgoing>
      <bpmn:outgoing>Flow_mgr_view</bpmn:outgoing>
      <bpmn:outgoing>Flow_mgr_delete</bpmn:outgoing>
      <bpmn:outgoing>Flow_mgr_report</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Mgr_EditEmployee" name="Edit Employee Category,&#10;Role or Department" camunda:candidateGroups="manager">
      <bpmn:incoming>Flow_mgr_edit</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_edit_save</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Mgr_ViewAll" name="View All Employee&#10;Categories &#38; Departments" camunda:class="com.company.EmployeeReadService">
      <bpmn:incoming>Flow_mgr_view</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_view_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Mgr_DeleteEmployee" name="Delete / Terminate&#10;Employee Record" camunda:candidateGroups="manager">
      <bpmn:incoming>Flow_mgr_delete</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_delete_confirm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Mgr_GenerateReport" name="Generate Employee&#10;Department Report" camunda:class="com.company.ReportService">
      <bpmn:incoming>Flow_mgr_report</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_report_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Mgr_SaveChanges" name="Save Manager Changes to DB&#10;+ Log Audit Trail" camunda:class="com.company.EmployeeWriteService">
      <bpmn:incoming>Flow_mgr_edit_save</bpmn:incoming>
      <bpmn:incoming>Flow_mgr_delete_confirm</bpmn:incoming>
      <bpmn:incoming>Flow_mgr_report_done</bpmn:incoming>
      <bpmn:incoming>Flow_mgr_view_done</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ManagerSession" name="Manager Session End&#10;(Logout)">
      <bpmn:incoming>Flow_mgr_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_mgr_action_gw" sourceRef="Task_ManagerDashboard" targetRef="GW_ManagerAction" />
    <bpmn:sequenceFlow id="Flow_mgr_edit" name="Edit" sourceRef="GW_ManagerAction" targetRef="Task_Mgr_EditEmployee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${managerAction == 'EDIT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_mgr_view" name="View" sourceRef="GW_ManagerAction" targetRef="Task_Mgr_ViewAll" />
    <bpmn:sequenceFlow id="Flow_mgr_delete" name="Delete" sourceRef="GW_ManagerAction" targetRef="Task_Mgr_DeleteEmployee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${managerAction == 'DELETE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_mgr_report" name="Report" sourceRef="GW_ManagerAction" targetRef="Task_Mgr_GenerateReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${managerAction == 'REPORT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_mgr_edit_save" sourceRef="Task_Mgr_EditEmployee" targetRef="Task_Mgr_SaveChanges" />
    <bpmn:sequenceFlow id="Flow_mgr_delete_confirm" sourceRef="Task_Mgr_DeleteEmployee" targetRef="Task_Mgr_SaveChanges" />
    <bpmn:sequenceFlow id="Flow_mgr_report_done" sourceRef="Task_Mgr_GenerateReport" targetRef="Task_Mgr_SaveChanges" />
    <bpmn:sequenceFlow id="Flow_mgr_view_done" sourceRef="Task_Mgr_ViewAll" targetRef="Task_Mgr_SaveChanges" />
    <bpmn:sequenceFlow id="Flow_mgr_done" sourceRef="Task_Mgr_SaveChanges" targetRef="End_ManagerSession" />
  </bpmn:process>
  <bpmn:category id="Category_0zzcmw4">
    <bpmn:categoryValue id="CategoryValue_04uyvmv" value="HR Actions" />
  </bpmn:category>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Employee_Management">
      <bpmndi:BPMNShape id="Participant_1s7b1hr_di" bpmnElement="Employee" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2910" height="2090" />
